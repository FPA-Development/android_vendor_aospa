<manifest>
  <include name="../platforms/sun.xml" />

  <!-- Re-declare device/qcom/kernelscripts without the kernel_definitions.mk linkfile so inline kernel.mk is used -->
  <project path="device/qcom/kernelscripts" name="AOSPA/android_kernel_build" remote="aospa" />

  <!-- PenguinOS lineage compat shims (libtinyxml2-v36, libaudioutils_shim, libprocessgroup_shim, etc.) -->
  <project path="hardware/lineage/compat" name="Project-PenguinOS/hardware_lineage_compat" remote="penguin" revision="celerity" />

  <!-- LineageOS QTI vibrator HAL with qti_vibrator effect_lib & use_effect_stream support -->
  <project path="vendor/qcom/opensource/vibrator" name="LineageOS/android_vendor_qcom_opensource_vibrator" remote="github" revision="lineage-24.0" />

  <!-- Device Dependencies -->
  <project path="device/xiaomi/annibale" name="FPA-Development/android_device_xiaomi_annibale" remote="github" revision="celerity" />
  <project path="hardware/xiaomi" name="FPA-Development/android_hardware_xiaomi" remote="github" revision="celerity" />
  <project path="kernel/xiaomi/sm8750" name="FPA-Development/android_kernel_xiaomi_sm8750" remote="github" revision="lineage-24.0" />
  <project path="kernel/xiaomi/sm8750-devicetrees" name="FPA-Development/android_kernel_xiaomi_sm8750-devicetrees" remote="github" revision="lineage-24.0" />
  <project path="kernel/xiaomi/sm8750-modules" name="FPA-Development/android_kernel_xiaomi_sm8750-modules" remote="github" revision="lineage-24.0" />

  <!-- Re-extract vendor/xiaomi/annibale with device/xiaomi/annibale/extract-files.py,
       or uncomment below once pushed to your vendor repository:
  <project path="vendor/xiaomi/annibale" name="FPA-Development/proprietary_vendor_xiaomi_annibale" remote="github" revision="celerity" />
  -->

  <!-- Inline kernel build tools -->
  <project path="prebuilts/kernel-build-tools" name="kernel/prebuilts/build-tools" remote="aosp" revision="main" clone-depth="1" />
  <project path="lineage/scripts" name="LineageOS/scripts" remote="github" revision="main" clone-depth="1" />
  <project path="prebuilts/tools-lineage" name="LineageOS/android_prebuilts_tools-lineage" remote="github" revision="lineage-24.0" clone-depth="1" />

  <!-- Dolby -->
  <project path="packages/apps/LunarisDolby" name="unmoved21/packages_apps_LunarisDolby" remote="github" revision="16.0" />
</manifest>
